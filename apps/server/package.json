{
  "name": "@yige/server",
  "version": "0.1.0",
  "private": true,
  "description": "弈阁服务端：HTTP API、WebSocket、账号与战绩",
  "main": "src/index.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node -r ts-node/register -r tsconfig-paths/register ./src/index.ts",
