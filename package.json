{
  "name": "yige-hall",
  "version": "0.1.0",
  "private": true,
  "description": "弈阁 · 在线棋类对战平台",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:engine && concurrently -k -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @yige/server",
    "dev:web": "npm run dev -w @yige/web",
    "build": "npm run build:engine && npm run build:web",
    "build:engine": "npm run build -w @yige/engine",
    "build:web": "npm run build -w @yige/web",
    "typecheck": "npm run typecheck -w @yige/server",
    "start": "npm run start -w @yige/server"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3"
  }
}
